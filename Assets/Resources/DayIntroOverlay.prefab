  m_EditorClassIdentifier: Assembly-CSharp::DayIntroOverlay
  overlayGroup: {fileID: 228860380725938376}
  dialogueText: {fileID: 5205794963581069385}
  dialogueLines:
  - "I don\u2019t know how long it\u2019s been since he passed away"
  - 'I want to get away from everyone '
  - "I don\u2019t want to talk to anyone"
  - "I don\u2019t want anybody calling me"
  - "I don\u2019t deserve to hear them ask if I\u2019m okay"
  - "I don\u2019t deserve to hear them ask if I\u2019m okay"
  - "Because I know I\u2019m not, and I know why"
